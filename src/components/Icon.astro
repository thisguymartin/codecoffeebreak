---
interface Props {
  name: 'arrow' | 'github' | 'coffee' | 'theme' | 'rss';
  size?: number;
}
const { name, size = 18 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class="icon"
>
  {name === 'arrow' && <path d="M6 18 18 6M6 6h12v12" />}
  {name === 'coffee' && (
    <>
      <path d="M4 9h13v7a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9Zm13 2h1a3 3 0 1 1 0 6h-1M8 2v3m4-3v3m4-3v3M2 23h19" />
    </>
  )}
  {name === 'theme' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
    </>
  )}
  {name === 'rss' && (
    <>
      <path d="M4 4a16 16 0 0 1 16 16M4 10a10 10 0 0 1 10 10" />
      <circle cx="5" cy="19" r="1" fill="currentColor" />
    </>
  )}
  {name === 'github' && (
    <path d="M9 19c-4 1-4-2-6-2m12 5v-4a3.5 3.5 0 0 0-1-3c3-.4 6-1.5 6-6a4.8 4.8 0 0 0-1.4-3.4A4.5 4.5 0 0 0 18.5 2S17 1.6 14 3a13 13 0 0 0-6 0C5 1.6 3.5 2 3.5 2a4.5 4.5 0 0 0-.1 3.6A4.8 4.8 0 0 0 2 9c0 4.5 3 5.6 6 6a3.5 3.5 0 0 0-1 3v4" />
  )}
</svg>
