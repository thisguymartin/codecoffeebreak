---
import type { CollectionEntry } from 'astro:content';
import QuickCalculator from './QuickCalculator.astro';
import Icon from './Icon.astro';
interface Props {
  tool: CollectionEntry<'tools'>;
}
const { tool } = Astro.props;
---

{tool.id === 'ai-context-calculator' ? (
  <QuickCalculator />
) : (
  <article class="project-row">
    <div>
      <h3>
        <a href={`/tools/${tool.id}`}>{tool.data.title}</a>
      </h3>
      <p>{tool.data.description}</p>
    </div>
    <a class="text-link" href={`/tools/${tool.id}`}>
      Open tool <Icon name="arrow" size={14} />
    </a>
  </article>
)}
