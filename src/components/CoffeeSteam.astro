<div class="coffee-break" data-coffee-state="still">
  <div class="painted-cup" aria-hidden="true">
    <img
      class="painted-mug"
      src="/images/cafe-mug.png"
      width="384"
      height="384"
      alt=""
      decoding="async"
    />
    <svg class="painted-steam" viewBox="0 0 200 190" fill="none">
      <g
        class="coffee-steam"
        stroke="currentColor"
        stroke-width="4"
        stroke-linecap="round"
      >
        <path class="steam-line" d="M78 69c-16-16 15-19 2-38" />
        <path class="steam-line" d="M103 64c-15-19 17-23 3-43" />
        <path class="steam-line" d="M125 70c-12-14 12-20 1-34" />
      </g>
    </svg>
  </div>
  <div class="coffee-controls">
    <span>A little room to think.</span>
    <button type="button" class="steam-toggle" aria-pressed="false" hidden>
      Pause steam
    </button>
  </div>
</div>
<script>
  const coffee = document.querySelector<HTMLElement>('[data-coffee-state]');
  const button = coffee?.querySelector<HTMLButtonElement>('.steam-toggle');
  if (coffee && button) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let preference: 'play' | 'pause' = 'play';
    let inView = false;
    const update = () => {
      coffee.dataset.coffeeState =
        preference === 'play' && inView && !document.hidden && !reduced.matches
          ? 'running'
          : 'still';
      button.disabled = reduced.matches;
      button.textContent = reduced.matches
        ? 'Motion reduced'
        : preference === 'pause'
          ? 'Play steam'
          : 'Pause steam';
      button.setAttribute('aria-pressed', String(preference === 'pause'));
    };
    button.hidden = false;
    button.addEventListener('click', () => {
      preference = preference === 'play' ? 'pause' : 'play';
      update();
    });
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      update();
    });
    observer.observe(coffee);
    document.addEventListener('visibilitychange', update);
    reduced.addEventListener('change', update);
    update();
  }
</script>
