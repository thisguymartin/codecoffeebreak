---
interface Props {
  size?: number;
}
const { size = 48 } = Astro.props;
---

<svg
  class="coffee-mark"
  width={size}
  height={size}
  viewBox="0 0 80 80"
  fill="none"
  aria-hidden="true"
>
  <path
    class="coffee-mark-steam"
    d="M31 14v14M45 14v14"
    stroke="currentColor"
    stroke-width="5"
    stroke-linecap="round"
  />
  <path
    class="coffee-mark-cup"
    d="M20 35h38v11c0 12-8 20-19 20S20 58 20 46V35Z"
    stroke="currentColor"
    stroke-width="4"
    stroke-linejoin="round"
  />
  <path
    class="coffee-mark-cup"
    d="M58 40h3c7 0 7 12 0 12h-4"
    stroke="currentColor"
    stroke-width="4"
    stroke-linecap="round"
  />
</svg>
