---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
export async function getStaticPaths() {
  return (
    await getCollection(
      'meetups',
      ({ data }) => import.meta.env.DEV || !data.draft,
    )
  ).map((meetup) => ({ params: { id: meetup.id }, props: { meetup } }));
}
const { meetup } = Astro.props;
const { data } = meetup;
const { Content } = await render(meetup);
const submission = new URL(
  'https://github.com/thisguymartin/codecoffeebreak/issues/new',
);
submission.searchParams.set('template', 'meetup-submission.yml');
submission.searchParams.set(
  'meetup',
  new URL(`/meetups/${meetup.id}/`, site.url).href,
);
submission.searchParams.set(
  'meeting-date',
  'startsAt' in data
    ? new Date(data.startsAt).toLocaleDateString('en-CA', {
        timeZone: 'America/Phoenix',
      })
    : 'TBD',
);
---

<BaseLayout title={data.title} description={data.description}>
  <div class="wrap">
    <header class="page-heading">
      <a class="text-link" href="/meetups">
        All meetups
      </a>
      <h1>{data.title}</h1>
      <p>{data.description}</p>
      {data.draft && (
        <p class="editorial-disclosure">Draft meetup · Local preview only.</p>
      )}
    </header>
    <div class="page-body meetup-detail">
      <section class="meetup-facts" aria-label="Meetup details">
        <dl>
          <div>
            <dt>Status</dt>
            <dd>
              {
                {
                  planning: 'In planning',
                  scheduled: 'Scheduled',
                  completed: 'Completed',
                }[data.status]
              }
            </dd>
          </div>
          <div>
            <dt>Date</dt>
            <dd>
              {data.status === 'planning' ? (
                'To be announced'
              ) : (
                <time datetime={data.startsAt}>
                  {new Date(data.startsAt).toLocaleString('en-US', {
                    timeZone: 'America/Phoenix',
                    dateStyle: 'long',
                    timeStyle: 'short',
                  })}{' '}
                  · Phoenix time
                </time>
              )}
            </dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>
              {data.city}
              {data.status === 'planning'
                ? ' · Venue to be announced'
                : ` · ${data.venue}`}
            </dd>
          </div>
          <div>
            <dt>Topics</dt>
            <dd>{data.topics.join(' · ')}</dd>
          </div>
        </dl>
        {data.status === 'scheduled' && data.rsvp ? (
          <a class="button" href={data.rsvp}>
            RSVP for this meetup ↗
          </a>
        ) : (
          data.status !== 'completed' && <p>Registration is not open yet.</p>
        )}
      </section>
      <article class="prose">
        {data.status === 'completed' && (
          <section>
            <h2>What we talked about</h2>
            <p>{data.recap}</p>
          </section>
        )}
        <Content />
        {data.status === 'completed' && data.links.length > 0 && (
          <section>
            <h2>Links from the meetup</h2>
            <ul>
              {data.links.map((link) => (
                <li>
                  <a href={link.url}>{link.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
        {data.status === 'completed' && data.projects.length > 0 && (
          <section>
            <h2>Projects we shared</h2>
            {data.projects.map((project) => (
              <article class="shared-project">
                {project.image && (
                  <img
                    src={project.image.src}
                    alt={project.image.alt}
                    width="960"
                    height="640"
                    loading="lazy"
                  />
                )}
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                <p>
                  By{' '}
                  {project.creatorUrl ? (
                    <a href={project.creatorUrl}>{project.creator}</a>
                  ) : (
                    project.creator
                  )}
                </p>
                <div class="shared-project-links">
                  {project.github && (
                    <a href={project.github}>GitHub repository ↗</a>
                  )}
                  {project.demo && <a href={project.demo}>Try the demo ↗</a>}
                </div>
              </article>
            ))}
          </section>
        )}
      </article>
      <section class="meetup-submit" aria-labelledby="share-heading">
        <h2 id="share-heading">Have something to share?</h2>
        <p>
          Suggest a discussion topic or submit a project for this meetup.
          Include how you want to be credited. Submissions are reviewed before
          appearing here.
        </p>
        {site.meetupSubmissionsEnabled ? (
          <>
            <a class="text-link" href={submission.href}>
              Submit through GitHub ↗
            </a>
            <p class="editorial-note">
              Requires a GitHub account. Your issue will be public. Do not
              include private information, customer data, or photos of people
              without permission.
            </p>
          </>
        ) : (
          <p class="editorial-note">Online submissions are not open yet.</p>
        )}
      </section>
    </div>
  </div>
</BaseLayout>
