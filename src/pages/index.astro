---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ToolCard from '../components/ToolCard.astro';
import CoffeeSteam from '../components/CoffeeSteam.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import {
  publishedArticles,
  topicSlug,
  dateLabel,
  readingTime,
  typeLabel,
} from '../utils/content';
import { site } from '../config/site';
const articles = await publishedArticles();
const lead = articles.find((article) => article.data.featured) ?? articles[0];
const latest = articles.filter((article) => article.id !== lead?.id);
const tools = await getCollection('tools', ({ data }) => !data.draft);
---

<BaseLayout>
  <div class="wrap">
    <header class="publication-intro cafe-intro">
      <div>
        <h1>
          Take a break.
          <br />
          Learn a little.
        </h1>
        <p>
          Short reads about the things software does when you least expect it.
          Small experiments, useful tools, and a place to slow down.
        </p>
        <a class="text-link" href="#latest-heading">
          Find your next read <Icon name="arrow" size={13} />
        </a>
      </div>
      <CoffeeSteam />
    </header>
    <nav class="home-threads" aria-label="Engineering subjects">
      {['Architecture', 'Developer Tools', 'Performance', 'AI Engineering'].map(
        (topic) => (
          <a href={'/topics/' + topicSlug(topic)}>{topic}</a>
        ),
      )}
    </nav>
    <div class="publication-grid">
      <section aria-labelledby="latest-heading">
        <div class="section-heading">
          <h2 id="latest-heading">Fresh reads</h2>
          <a class="text-link" href="/articles">
            The reading shelf <Icon name="arrow" size={13} />
          </a>
        </div>
        {lead ? (
          <article class="lead-story">
            <div>
              <div class="article-row-meta">
                <span class="type-label">{typeLabel(lead.data.type)}</span>
                <span>·</span>
                <span>{readingTime(lead.body)} min read</span>
              </div>
              <h3>
                <a href={'/articles/' + lead.id}>{lead.data.title}</a>
              </h3>
              <p>{lead.data.description}</p>
              <div class="lead-byline">
                {lead.data.author} <span>·</span>{' '}
                <time datetime={lead.data.publishedAt.toISOString()}>
                  {dateLabel(lead.data.publishedAt)}
                </time>
              </div>
              <a class="text-link" href={'/articles/' + lead.id}>
                Settle in & read <Icon name="arrow" size={13} />
              </a>
            </div>
            {lead.data.image && (
              <img
                src={lead.data.image}
                alt={lead.data.imageAlt ?? ''}
                width="1200"
                height="800"
                fetchpriority="high"
                decoding="async"
              />
            )}
          </article>
        ) : (
          <div class="empty-state">
            <h3>The first article is on its way.</h3>
            <p>Try a tool below while the writing takes shape.</p>
          </div>
        )}
        <div class="article-list">
          {latest.slice(0, 5).map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
        <section class="content-section" aria-labelledby="tools-heading">
          <div class="section-heading">
            <h2 id="tools-heading">Something to try</h2>
            <a class="text-link" href="/tools">
              All tools <Icon name="arrow" size={13} />
            </a>
          </div>
          {tools.slice(0, 4).map((tool) => (
            <ToolCard tool={tool} />
          ))}
        </section>
      </section>
      <aside class="publication-sidebar">
        <section>
          <h2>Explore topics</h2>
          <nav class="sidebar-topics" aria-label="Browse engineering topics">
            {site.topics.map((topic) => (
              <a href={'/topics/' + topicSlug(topic)}>
                {topic}
                <Icon name="arrow" size={12} />
              </a>
            ))}
          </nav>
        </section>
        <section class="contribution-note">
          <h2>Pull up a chair.</h2>
          <p>
            Have a small lesson worth passing on? The writing guide is ready.
            Submissions will open once there is a real place to receive them.
          </p>
          <a class="text-link" href="/contribute">
            See the writing guide <Icon name="arrow" size={13} />
          </a>
        </section>
      </aside>
    </div>
    <section
      class="coffee-question content-section"
      aria-labelledby="question-heading"
    >
      <h2 id="question-heading">A question for your next coffee break</h2>
      <p>
        If a request times out, how do you find out whether the work actually
        happened?
      </p>
      <a class="text-link" href="/articles/a-timeout-is-not-a-receipt">
        Think through an example <Icon name="arrow" size={13} />
      </a>
    </section>
    <Newsletter />
  </div>
</BaseLayout>
