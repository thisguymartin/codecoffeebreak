---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { publishedArticles, readingTime } from '../utils/content';

const articles = (await publishedArticles()).slice(0, 3);
const sessions = [
  { time: '15 min', title: 'Meet the people at your table', description: 'Grab a coffee, introduce yourself, and share what you want to learn or work on.' },
  { time: '50 min', title: 'Build, experiment, ask questions', description: 'Bring a project, try an AI workflow, or pair with someone on a problem. Work at your own pace.' },
  { time: '25 min', title: 'Share what you tried', description: 'Show a small demo, compare approaches, or talk through what failed. Unfinished work is welcome.' },
];
---

<BaseLayout
  title="Phoenix Developer & AI Meetups"
  image="https://images.unsplash.com/photo-1776437209767-ee8e2d48aaa7?auto=format&fit=crop&w=1200&h=900&q=85"
  imageAlt="A bright coffee shop with wooden tables, pendant lights, and large windows."
>
  <div class="wrap event-home">
    <header class="event-intro">
      <div class="event-intro-copy">
      <h1>Coffee, code &amp;<br />good company.</h1>
      <p>Developer meetups in Phoenix, Arizona. Explore AI agents, build side projects, and meet people over coffee.</p>
      <a class="button" href="#next-meetup">See the next meetup <Icon name="arrow" size={14} /></a>
      </div>
      <figure class="event-photo">
        <img
          src="https://images.unsplash.com/photo-1776437209767-ee8e2d48aaa7?auto=format&amp;fit=crop&amp;w=1200&amp;h=900&amp;q=85"
          alt="A bright coffee shop with wooden tables, pendant lights, and large windows."
          width="1200"
          height="900"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>Café inspiration, not our confirmed venue. <a href="https://unsplash.com/photos/modern-cafe-interior-with-tables-and-chairs-csfkn8hN0Ao">Skyler Smith / Unsplash</a></figcaption>
      </figure>
    </header>

    <section class="event-announcement" id="next-meetup" aria-labelledby="event-heading">
      <div class="event-details">
        <p class="event-status">In planning</p>
        <h2 id="event-heading">The first Code Coffee Break</h2>
        <p>An informal session to meet fellow developers, try ideas, and learn together over coffee.</p>
        <dl>
          <div><dt>Date</dt><dd>To be announced</dd></div>
          <div><dt>Location</dt><dd>Phoenix, Arizona · venue to be announced</dd></div>
          <div><dt>Format</dt><dd>In person · around 90 minutes</dd></div>
        </dl>
        <p class="event-registration">Registration will open here when the date and venue are confirmed.</p>
      </div>
      <aside class="event-preparation" aria-labelledby="bring-heading">
        <h3 id="bring-heading">Come with something to explore</h3>
        <p>A laptop if you want to build. A question if you're stuck. A small demo if you want feedback.</p>
        <p>You don't need to be an AI expert or have a finished project.</p>
        <a class="text-link" href="#meetup-format">What happens at a meetup <Icon name="arrow" size={13} /></a>
      </aside>
    </section>

    <section class="event-format" id="meetup-format" aria-labelledby="format-heading">
      <div class="event-section-intro">
        <h2 id="format-heading">A little structure.<br />Plenty of time to build.</h2>
        <p>The proposed format keeps introductions short and leaves room for hands-on work and conversation.</p>
      </div>
      <ol class="event-agenda">
        {sessions.map((session) => (
          <li>
            <span>{session.time}</span>
            <div><h3>{session.title}</h3><p>{session.description}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="event-conversation" aria-labelledby="explore-heading">
      <h2 id="explore-heading">What we can work on together</h2>
      <div>
        <p>AI coding workflows. Agents that use tools. Context and memory. Testing whether an agent did the right thing. Or the side project you've been meaning to start.</p>
        <p>Developers at any stage are welcome. You can build, watch, ask questions, or help someone else.</p>
      </div>
    </section>

    <section class="event-resources" aria-labelledby="resources-heading">
      <div class="section-heading">
        <div><h2 id="resources-heading">For your next coffee break</h2><p>A few notes to read before we meet.</p></div>
        <a class="text-link" href="/articles">All resources <Icon name="arrow" size={13} /></a>
      </div>
      <ul>
        {articles.map((article) => (
          <li><a href={`/articles/${article.id}`}><span>{article.data.title}</span><small>{readingTime(article.body)} min read</small><Icon name="arrow" size={13} /></a></li>
        ))}
      </ul>
      <a class="text-link event-tool-link" href="/tools/ai-context-calculator">Try the AI context cost calculator <Icon name="arrow" size={13} /></a>
    </section>
  </div>
</BaseLayout>
