---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedArticles } from '../../utils/content';
export async function getStaticPaths() {
  return (await getCollection('projects', ({ data }) => !data.draft)).map(
    (project) => ({ params: { id: project.id }, props: { project } }),
  );
}
const { project } = Astro.props;
const { Content } = await render(project);
const articles = (await publishedArticles()).filter((article) =>
  project.data.articles.includes(article.id),
);
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <div class="wrap">
    <header class="page-heading">
      <div class="breadcrumb">
        <a href="/projects">Projects</a>
        <span>/</span>
        <span>{project.data.status}</span>
      </div>
      <h1>{project.data.title}</h1>
      <p>{project.data.description}</p>
      <div class="tech-list">{project.data.technologies.join(' / ')}</div>
      {project.data.github && (
        <a class="text-link" href={project.data.github}>
          View repository ↗
        </a>
      )}
    </header>
    <div class="page-body">
      <article class="prose">
        <Content />
      </article>
      {articles.length > 0 && (
        <aside class="related">
          <h2>From the notebook</h2>
          {articles.map((article) => (
            <a href={`/articles/${article.id}`}>{article.data.title} ↗</a>
          ))}
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
