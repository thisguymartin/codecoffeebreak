{
  "name": "codecoffeebreak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "deploy": "pnpm build && wrangler deploy",
    "new:article": "node scripts/content.mjs article",
    "new:project": "node scripts/content.mjs project",
    "note": "node scripts/content.mjs note",
    "format": "prettier --write src scripts tests astro.config.mjs",
    "format:check": "prettier --check src scripts tests astro.config.mjs",
    "verify": "pnpm check && pnpm test && pnpm build && node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "astro": "^7.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
